+#!/usr/bin/env python3
+"""Fixed-time midgame MPC self-play, sequential on one CPU.
+
+python3 tools/bench/mpc_match.py --out OUT --openings 4 --budgets 25,100
+Candidates play a baseline with colours swapped on identical XOT openings.
+Only roots above --endgame-empties use the candidate selectivity. Endgame
+requests, their time cap, and the TT reset at the boundary are shared.
+"""
+import argparse
+import csv
+import hashlib
+import json
+import math
+import os
+import random
+import statistics
+import subprocess
+import time
+from itertools import combinations
+from pathlib import Path
+
+from common import POSITIONS, REPO, paths
+from match import Gtp, play_game, xot
+
+
+def sha256(path):
+    with open(path, "rb") as f:
+        return hashlib.file_digest(f, "sha256").hexdigest()
+
+
+def percentile(values, fraction):
+    values = sorted(values)
+    return values[round((len(values) - 1) * fraction)] if values else None
+
+
+def validate_moves(rows, percent, budget, endgame_empties, endgame_ms, mid_sigma=None, horizon_endgame=False):
+    if not rows:
+        raise RuntimeError("missing move telemetry")
+    if horizon_endgame:
+        for row in rows:
+            iterations = row["iterations"]
+            if (row["budget_ms"] != budget or row["reset_tt"]
+                    or not row.get("horizon_endgame") or not iterations
+                    or row["stop"] == "WorkerFailed"
+                    or row.get("mid_sigma") != mid_sigma):
+                raise RuntimeError("invalid shared-budget horizon search")
+            expected_depth = 1
+            end_stages = []
+            previous_ms = -1
+            for iteration in iterations:
+                if iteration["elapsed_ms"] < previous_ms:
+                    raise RuntimeError("iteration clock restarted")
+                previous_ms = iteration["elapsed_ms"]
+                if iteration["endgame"]:
+                    if expected_depth != row["empties"]:
+                        raise RuntimeError("endgame before depth reaches empties")
+                    end_stages.append(iteration["percent"])
+                    if end_stages != [99, 100][:len(end_stages)] or len(end_stages) > 2:
+                        raise RuntimeError("endgame must be 99 then 100")
+                else:
+                    if (end_stages or iteration["depth"] != expected_depth
+                            or expected_depth >= row["empties"] or iteration["percent"] != percent):
+                        raise RuntimeError("incorrect midgame depth/selectivity")
+                    expected_depth += 1
+            last = iterations[-1]
+            if (row["endgame"] != last["endgame"] or row["depth"] != last["depth"]
+                    or row["percent"] != last["percent"]
+                    or row["solved"] != (end_stages == [99, 100])
+                    or row["phase"] != ("endgame" if end_stages else "midgame")):
+                raise RuntimeError("result differs from last completed iteration")
+        return
+    end_rows = []
+    for row in rows:
+        end = row["empties"] <= endgame_empties
+        if row["phase"] != ("endgame" if end else "midgame"):
+            raise RuntimeError("incorrect phase boundary")
+        if row["budget_ms"] != (endgame_ms if end else budget):
+            raise RuntimeError("incorrect move budget")
+        if row["stop"] == "WorkerFailed" or not row["iterations"]:
+            raise RuntimeError("worker failure or no completed iteration")
+        if not end:
+            if mid_sigma is not None and row.get("mid_sigma") != mid_sigma:
+                raise RuntimeError("incorrect experimental midgame multiple")
+            if row["reset_tt"] or row["endgame"] or any(
+                p["endgame"] or p["percent"] != percent for p in row["iterations"]
+            ):
+                raise RuntimeError("midgame settings changed during search")
+        else:
+            if mid_sigma is not None and row.get("mid_sigma") is not None:
+                raise RuntimeError("experimental midgame multiple leaked into endgame")
+            end_rows.append(row)
+    if end_rows and [r["reset_tt"] for r in end_rows] != [True] + [False] * (len(end_rows) - 1):
+        raise RuntimeError("endgame TT reset must happen exactly once per engine/game")
+
+
+def telemetry_summary(rows):
+    mid = [r for r in rows if r["phase"] == "midgame"]
+    end = [r for r in rows if r["phase"] == "endgame"]
+    last_has_searches = 0
+    for r in mid:
+        it = r["iterations"]
+        last_has_searches += it[-1]["searches"] > (it[-2]["searches"] if len(it) > 1 else 0)
+    return {
+        "mid_moves": len(mid),
+        "mean_depth": statistics.mean(r["depth"] for r in mid) if mid else None,
+        "mid_search_ms_median": percentile([r["search_ms"] for r in mid], .5),
+        "mid_search_ms_p95": percentile([r["search_ms"] for r in mid], .95),
+        "mid_search_ms_max": max((r["search_ms"] for r in mid), default=None),
+        "mid_wall_ms_p95": percentile([r["wall_ms"] for r in mid], .95),
+        "mid_wall_ms_max": max((r["wall_ms"] for r in mid), default=None),
+        "last_iteration_mpc_moves": last_has_searches,
+        "mid_cuts": sum(r["cuts"] for r in mid),
+        "mid_verification_searches": sum(r["searches"] for r in mid),
+        "mean_last_done_ms": statistics.mean(r["iterations"][-1]["elapsed_ms"] for r in mid) if mid else None,
+        "end_moves": len(end),
+        "end_solved": sum(r["solved"] for r in end),
+        "end_search_ms_p95": percentile([r["search_ms"] for r in end], .95),
+        "end_wall_ms_max": max((r["wall_ms"] for r in end), default=None),
+    }
+
+
+def pairings(candidates, baseline, round_robin):
+    return list(combinations(candidates, 2)) if round_robin else [(p, baseline) for p in candidates]
+
+
+def tournament_scores(games):
+    players = {}
+    matrix = {}
+    for game in games:
+        left, right = int(game["candidate"]), int(game["opponent"])
+        diff = int(game["diff"])
+        for player, opponent, d in [(left, right, diff), (right, left, -diff)]:
+            data = players.setdefault(player, {"diffs": [], "openings": {}})
+            data["diffs"].append(d)
+            score = (d > 0) + .5 * (d == 0)
+            data["openings"].setdefault(game["opening"], []).append(score)
+            matrix.setdefault((player, opponent), []).append(score)
+    result = []
+    for player, data in sorted(players.items()):
+        diffs = data["diffs"]
+        opening_scores = [statistics.mean(s) for s in data["openings"].values()]
+        rng = random.Random(1)
+        boot = [statistics.mean(rng.choices(opening_scores, k=len(opening_scores))) for _ in range(4000)]
+        result.append({"percent": player, "games": len(diffs), "wins": sum(d > 0 for d in diffs),
+                       "draws": sum(d == 0 for d in diffs), "losses": sum(d < 0 for d in diffs),
+                       "score": statistics.mean(opening_scores), "mean_diff": statistics.mean(diffs),
+                       "opening_bootstrap_95": [percentile(boot, .025), percentile(boot, .975)],
+                       "opponents": {str(o): {"games": len(s), "score": statistics.mean(s)}
+                                     for (p, o), s in matrix.items() if p == player}})
+    return sorted(result, key=lambda x: (-x["score"], x["percent"]))
+
+
+def summarize(out, games, round_robin=False):
+    groups = {}
+    for game in games:
+        key = (int(game["budget_ms"]), int(game["candidate"]), int(game["opponent"]) if round_robin else None)
+        groups.setdefault(key, []).append(game)
+    report = []
+    for (budget, candidate, opponent), group in sorted(groups.items()):
+        diffs = [int(g["diff"]) for g in group]
+        telemetry = {"candidate": [], "baseline": []}
+        pairs = {}
+        for g in group:
+            pairs.setdefault(g["opening"], []).append((int(g["diff"]) > 0) + .5 * (int(g["diff"]) == 0))
+            for side in telemetry:
+                log = out / "logs" / f'{g["id"]}-{side}.jsonl'
+                telemetry[side].extend(json.loads(line) for line in log.read_text().splitlines())
+        if any(len(pair) != 2 for pair in pairs.values()):
+            raise RuntimeError("incomplete colour pair")
+        pair_scores = [statistics.mean(pair) for pair in pairs.values()]
+        rng = random.Random(1)
+        boot = [statistics.mean(rng.choices(pair_scores, k=len(pair_scores))) for _ in range(2000)]
+        report.append({
+            "budget_ms": budget, "candidate": candidate, "games": len(group),
+            **({"opponent": opponent} if round_robin else {}),
+            "wins": sum(d > 0 for d in diffs), "draws": sum(d == 0 for d in diffs),
+            "losses": sum(d < 0 for d in diffs), "score": statistics.mean(pair_scores),
+            "paired_bootstrap_95": [percentile(boot, .025), percentile(boot, .975)],
+            "mean_diff": statistics.mean(diffs),
+            "mean_game_seconds": statistics.mean(float(g["wall_seconds"]) for g in group),
+            **{side + "_stats": telemetry_summary(rows) for side, rows in telemetry.items()},
+        })
+    (out / "summary.json").write_text(json.dumps(report, indent=2) + "\n")
+    for r in report:
+        label = f' vs p{r["opponent"]}' if round_robin else ""
+        print(f'{r["budget_ms"]}ms p{r["candidate"]}{label}: {r["wins"]}/{r["draws"]}/{r["losses"]}'
+              f' score={r["score"]:.1%} depth={r["candidate_stats"]["mean_depth"]:.2f}'
+              f' vs {r["baseline_stats"]["mean_depth"]:.2f}')
+    if round_robin:
+        scores = tournament_scores(games)
+        (out / "tournament.json").write_text(json.dumps(scores, indent=2) + "\n")
+        for row in scores:
+            print(f'p{row["percent"]}: {row["wins"]}/{row["draws"]}/{row["losses"]} score={row["score"]:.1%}')
+    return report
+
+
+def main():
+    tools = paths()
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--gtp", type=Path, default=tools["gtp"])
+    parser.add_argument("--model", type=Path, default=tools["model"])
+    parser.add_argument("--xot", type=Path, default=POSITIONS / "xot-openingslarge.txt")
+    parser.add_argument("--openings", type=int, default=4)
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--budgets", default="25,100")
+    parser.add_argument("--candidates", default="68,95,99,100")
+    parser.add_argument("--baseline", type=int, default=85)
+    parser.add_argument("--round-robin", action="store_true", help="play each unordered pair of candidates; baseline is unused")
+    parser.add_argument("--mid-sigmas", type=Path, help="JSON empirical multiples, keyed by probability, under sigmas")
+    parser.add_argument("--report-on-completion", action="store_true", help="also validate and summarize move telemetry before marking completion")
+    parser.add_argument("--horizon-endgame", action="store_true", help="switch at depth=empties to 99 then 100 within the same move budget")
+    parser.add_argument("--endgame-empties", type=int, default=18)
+    parser.add_argument("--endgame-ms", type=int, default=25)
+    parser.add_argument("--cpu", type=int, default=0)
+    args = parser.parse_args()
+    budgets = [int(s) for s in args.budgets.split(",")]
+    candidates = [int(s) for s in args.candidates.split(",")]
+    mid_sigmas = {}
+    if args.mid_sigmas:
+        mid_sigmas = json.loads(args.mid_sigmas.read_text())["sigmas"]
+        if (not isinstance(mid_sigmas, dict) or any(
+                not 1 <= int(k) <= 99 or not math.isfinite(v) or v <= 0 for k, v in mid_sigmas.items())):
+            parser.error("invalid empirical midgame multiples")
+    allowed = {68, 77, 85, 95, 98, 99, 100}
+    allowed.update(int(k) for k in mid_sigmas)
+    if (not candidates or len(set(candidates)) != len(candidates) or not set(candidates) <= allowed
+            or args.baseline not in allowed or (not args.round_robin and args.baseline in candidates)
+            or (args.round_robin and (len(candidates) < 2 or len(budgets) != 1))
+            or not budgets or min(budgets) <= 0 or len(set(budgets)) != len(budgets)
+            or args.openings <= 0 or not 0 <= args.endgame_empties <= 52 or args.endgame_ms <= 0):
+        parser.error("invalid probabilities, budgets, opening count or boundary")
+    if args.cpu not in os.sched_getaffinity(0):
+        parser.error("CPU is outside the process affinity")
+    openings = xot(args.openings, args.xot, args.seed)
+    pairs = pairings(candidates, args.baseline, args.round_robin)
+    settings = {k: str(v.resolve()) if isinstance(v, Path) else v for k, v in vars(args).items() if k != "out"}
+    settings.update({"gtp_sha256": sha256(args.gtp), "model_sha256": sha256(args.model),
+                     "xot_sha256": sha256(args.xot), "runner_sha256": sha256(__file__), "openings_moves": openings})
+    support = [Path(__file__).with_name(name) for name in ("common.py", "match.py", "mpc_report.py", "mpc_sigmas.py")]
+    settings["support_sha256"] = {path.name: sha256(path) for path in support if path.exists()}
+    if args.mid_sigmas:
+        settings.update(mid_sigmas_sha256=sha256(args.mid_sigmas), empirical_mid_sigmas=mid_sigmas)
+    args.out.mkdir(parents=True, exist_ok=True)
+    manifest = args.out / "manifest.json"
+    if manifest.exists():
+        if json.loads(manifest.read_text())["settings"] != settings:
+            raise SystemExit("output settings differ; use a fresh output directory")
+    else:
+        manifest.write_text(json.dumps({"settings": settings,
+            "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=REPO, text=True).strip(),
+            "cpu": subprocess.check_output(["lscpu"], text=True),
+        }, indent=2) + "\n")
+        source_diff = subprocess.check_output(["git", "diff"], cwd=REPO)
+        # Newly added measurement helpers are not in plain git diff yet.
+        for path in [Path(__file__), *support]:
+            if path.exists() and subprocess.run(["git", "ls-files", "--error-unmatch", str(path.resolve())],
+                                               cwd=REPO, capture_output=True).returncode:
+                source_diff += subprocess.run(["git", "diff", "--no-index", "--", "/dev/null",
+                    str(path.resolve().relative_to(REPO))], cwd=REPO, capture_output=True).stdout
+        (args.out / "source.diff").write_bytes(source_diff)
+    (args.out / "logs").mkdir(exist_ok=True)
+    result_path = args.out / "games.tsv"
+    games = list(csv.DictReader(result_path.open(), delimiter="\t")) if result_path.exists() else []
+    done = {g["id"] for g in games}
+    os.environ["DEFT_GTP_JSON"] = "1"
+    fields = ["id", "opening", "budget_ms", "candidate", "candidate_color", "diff", "candidate_seconds", "baseline_seconds", "wall_seconds", "moves"]
+    if args.round_robin:
+        fields.append("opponent")
+    with result_path.open("a") as f:
+        writer = csv.DictWriter(f, fields, delimiter="\t")
+        if not games:
+            writer.writeheader()
+        for opening_id, opening in enumerate(openings):
+            for budget in budgets:
+                # Rotate both candidate order and which colour plays first.
+                offset = opening_id % len(pairs)
+                order = pairs[offset:] + pairs[:offset]
+                for candidate, opponent in order:
+                    for black in ([True, False] if opening_id % 2 == 0 else [False, True]):
+                        pair_label = f"-v{opponent}" if args.round_robin else ""
+                        game_id = f"o{opening_id}-t{budget}-p{candidate}{pair_label}-{'b' if black else 'w'}"
+                        if game_id in done:
+                            continue
+                        engines = {}
+                        started = time.monotonic()
+                        try:
+                            for side, percent in [("candidate", candidate), ("baseline", opponent)]:
+                                log = args.out / "logs" / f"{game_id}-{side}.jsonl"
+                                log.write_text("")
+                                extra = ["--mid-sigma", str(mid_sigmas[str(percent)])] if str(percent) in mid_sigmas else []
+                                if args.horizon_endgame:
+                                    extra += ["--horizon-endgame", "true"]
+                                engines[side] = Gtp([str(args.gtp), str(args.model), "--move-ms", str(budget),
+                                    "--mid-selectivity", str(percent), "--endgame-empties", str(args.endgame_empties),
+                                    "--endgame-ms", str(args.endgame_ms), "--tt", "64", *extra], args.cpu, log=log)
+                            diff, cs, bs, record = play_game({"deft": engines["candidate"], "opp": engines["baseline"]}, black, opening, "fixed")
+                        finally:
+                            for engine in engines.values():
+                                engine.close()
+                                engine.proc.wait(timeout=5)
+                        for side, percent in [("candidate", candidate), ("baseline", opponent)]:
+                            rows = [json.loads(line) for line in (args.out / "logs" / f"{game_id}-{side}.jsonl").read_text().splitlines()]
+                            validate_moves(rows, percent, budget, args.endgame_empties, args.endgame_ms, mid_sigmas.get(str(percent)), args.horizon_endgame)
+                        game = dict(zip(fields, [game_id, opening_id, budget, candidate, "black" if black else "white",
+                            diff, cs, bs, time.monotonic() - started, record]))
+                        if args.round_robin:
+                            game["opponent"] = opponent
+                        writer.writerow(game)
+                        f.flush()
+                        games.append({k: str(v) for k, v in game.items()})
+                        print(f"{game_id}: {diff:+d} ({game['wall_seconds']:.2f}s)", flush=True)
+    summarize(args.out, games, args.round_robin)
+    if args.report_on_completion:
+        from mpc_report import report
+        report(args.out)
+    (args.out / "completion.json").write_text(json.dumps({"status": "completed", "games": len(games)}, indent=2) + "\n")
+
+
+if __name__ == "__main__":
+    main()
