+#!/usr/bin/env python3
+"""Summarize move telemetry after mpc_match.py completes, without new games.
+
+usage: python3 tools/bench/mpc_report.py OUT
+Writes move-statistics.tsv/.md and diagnostics.json. Baseline moves are pooled
+over all opponents. Endgame iterations count as terminal depth (empties),
+while solved is reported separately because selective endgame is not exact.
+"""
+import argparse
+import csv
+import json
+import statistics
+from collections import defaultdict
+from pathlib import Path
+from math import comb
+
+from mpc_match import validate_moves
+
+
+def distribution(values):
+    return {"min": min(values), "max": max(values),
+            "mean": statistics.mean(values), "median": statistics.median(values)}
+
+
+def report(out):
+    settings = json.loads((out / "manifest.json").read_text())["settings"]
+    games = list(csv.DictReader((out / "games.tsv").open(), delimiter="\t"))
+    count = len(settings["candidates"].split(","))
+    pairs = comb(count, 2) if settings.get("round_robin") else count
+    expected = settings["openings"] * pairs * len(settings["budgets"].split(",")) * 2
+    if len(games) != expected or len({g["id"] for g in games}) != expected:
+        raise SystemExit(f"expected {expected} unique games; found {len(games)}")
+    groups = defaultdict(list)
+    for game in games:
+        for side in ("candidate", "baseline"):
+            percent = int(game["candidate"]) if side == "candidate" else int(game.get("opponent") or settings["baseline"])
+            rows = [json.loads(line) for line in (out / "logs" / f'{game["id"]}-{side}.jsonl').read_text().splitlines()]
+            validate_moves(rows, percent, int(game["budget_ms"]), settings["endgame_empties"], settings["endgame_ms"],
+                           settings.get("empirical_mid_sigmas", {}).get(str(percent)), settings.get("horizon_endgame", False))
+            for row in rows:
+                groups[(int(game["budget_ms"]), percent, row["phase"])].append(row)
+    results = []
+    for (budget, percent, phase), rows in sorted(groups.items()):
+        result = dict(mid_budget_ms=budget, percent=percent, phase=phase, moves=len(rows),
+                      solved=sum(r["solved"] for r in rows))
+        depths = [r["empties"] if r["endgame"] else r["depth"] for r in rows]
+        assert all(d is not None for d in depths)
+        for field, values in [("search_ms", [r["search_ms"] for r in rows]),
+                              ("wall_ms", [r["wall_ms"] for r in rows]), ("depth", depths)]:
+            result.update({field + "_" + k: v for k, v in distribution(values).items()})
+        result["target_reached"] = sum(r["depth"] == r["empties"] for r in rows) if phase == "midgame" else None
+        result["last_iteration_mpc_moves"] = sum(
+            r["iterations"][-1]["searches"] > (r["iterations"][-2]["searches"] if len(r["iterations"]) > 1 else 0)
+            for r in rows)
+        results.append(result)
+    with (out / "move-statistics.tsv").open("w") as f:
+        writer = csv.DictWriter(f, fieldnames=list(results[0]), delimiter="\t")
+        writer.writeheader()
+        writer.writerows(results)
+    mid = [r for (b, p, phase), rows in groups.items() if phase == "midgame" for r in rows]
+    end = [r for (b, p, phase), rows in groups.items() if phase == "endgame" for r in rows]
+    diagnostic = {"games": len(games), "game_wall_seconds": sum(float(g["wall_seconds"]) for g in games),
+                  "mid_moves": len(mid), "end_moves": len(end), "end_solved": sum(r["solved"] for r in end),
+                  "end_search_seconds": sum(r["search_ms"] for r in end) / 1000,
+                  "boundary_and_selectivity_validated": True,
+                  "mid_search_ms_max": max((r["search_ms"] for r in mid), default=None),
+                  "mid_wall_ms_max": max((r["wall_ms"] for r in mid), default=None),
+                  "end_search_ms_max": max((r["search_ms"] for r in end), default=None)}
+    (out / "diagnostics.json").write_text(json.dumps(diagnostic, indent=2) + "\n")
+    lines = ["# 1手の時間・完了深さ", "", "追加対戦なし。中央値は中央2件の平均（偶数件の場合）。85%などの基準側は全対戦相手を合算。時間の単位はms。", "",
+             "探索時間はエンジン内部、外側時間は探索前のTT消去等を含む。深さは最後の完了反復。終盤モードの反復が完了した場合は残り空き数を深さとし、完全読みの保証はsolved件数で区別する。", ""]
+    for phase in ("midgame", "endgame"):
+        for budget in sorted({key[0] for key in groups}):
+            lines += [f'## {phase} / 中盤指定 {budget} ms', "",
+                      "| 確率 | 着手数 | 時間最小 | 最大 | 平均 | 中央値 | 深さ最小 | 最大 | 平均 | 中央値 | 目標到達 | solved |",
+                      "|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|---:|"]
+            matching = [r for r in results if r["phase"] == phase and r["mid_budget_ms"] == budget]
+            for r in matching:
+                cells = [f'{r["percent"]}%', str(r["moves"])]
+                cells += [f'{r[k]:.3f}' for k in ("search_ms_min", "search_ms_max", "search_ms_mean", "search_ms_median")]
+                cells += [f'{r[k]:.2f}' for k in ("depth_min", "depth_max", "depth_mean", "depth_median")]
+                cells += [str(r["target_reached"]) if r["target_reached"] is not None else "—", str(r["solved"])]
+                lines.append("| " + " | ".join(cells) + " |")
+            lines += ["", "| 確率 | 外側時間最小 | 最大 | 平均 | 中央値 |", "|---|---:|---:|---:|---:|"]
+            for r in matching:
+                lines.append(f'| {r["percent"]}% | ' + " | ".join(f'{r[k]:.3f}' for k in ("wall_ms_min", "wall_ms_max", "wall_ms_mean", "wall_ms_median")) + " |")
+            lines.append("")
+    (out / "move-statistics.md").write_text("\n".join(lines) + "\n")
+    if settings.get("round_robin"):
+        standings = json.loads((out / "tournament.json").read_text())
+        report_lines = ["# 総当たりの結果", "", f"{len(games):,}局完了。対局時間の合計は{diagnostic['game_wall_seconds'] / 3600:.3f}時間。得点率は勝ち1・引き分け0.5で計算。", "",
+                   "| 順位 | 確率 | 勝 / 分 / 負 | 得点率 | 開局単位の95%区間 | 平均完了深さ |", "|---:|---|---:|---:|---:|---:|"]
+        mid_stats = {r["percent"]: r for r in results if r["phase"] == "midgame"}
+        for i, r in enumerate(standings, 1):
+            lo, hi = r["opening_bootstrap_95"]
+            report_lines.append(f"| {i} | {r['percent']}% | {r['wins']} / {r['draws']} / {r['losses']} | {r['score']:.2%} | {lo:.2%}〜{hi:.2%} | {mid_stats[r['percent']]['depth_mean']:.2f} |")
+        report_lines += ["", "[時間と完了深さ](move-statistics.md)、[全件検証](diagnostics.json)、[組ごとの成績と区間](summary.json)。順位はこの開局集合・対戦相手・時間条件に対するもので、多重比較の調整はしていない。"]
+        (out / "results.md").write_text("\n".join(report_lines) + "\n")
+    print(json.dumps(diagnostic, indent=2))
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("out", type=Path)
+    report(parser.parse_args().out)
