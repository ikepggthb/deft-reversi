+#!/usr/bin/env python3
+"""Compute empirical midgame multiples from an existing model's calibration.
+
+Requires the rules.json that exactly matches MODEL and its positions.tsv.
+No searches, weight changes, normal approximation or probability interpolation.
+"""
+import argparse
+import csv
+import hashlib
+import json
+import math
+import struct
+from pathlib import Path
+
+
+def digest(path):
+    with open(path, "rb") as f:
+        return hashlib.file_digest(f, "sha256").hexdigest()
+
+
+def quantile(values, p):
+    x = p * (len(values) - 1)
+    i = int(x)
+    f = x - i
+    return values[i] * (1 - f) + values[min(i + 1, len(values) - 1)] * f
+
+
+def generate(model, rules_path, positions, probabilities):
+    calibration = json.loads(rules_path.read_text())
+    data = model.read_bytes()
+    offset = data.rfind(b"MPC1")
+    if offset < 0:
+        raise ValueError("model has no MPC calibration")
+    sigmas = struct.unpack_from("<12d", data, offset + 4)
+    count = struct.unpack_from("<I", data, offset + 100)[0]
+    if offset + 104 + 28 * count != len(data):
+        raise ValueError("unexpected model calibration size")
+    actual = [struct.unpack_from("<4B3d", data, offset + 104 + 28 * k) for k in range(count)]
+    expected = [(int(r["exact"]), r["depth"], r["empties"], r["shallow_depth"],
+                 r["slope"], r["intercept"], r["deviation"]) for r in calibration["rules"]]
+    if sorted(actual) != sorted(expected) or list(sigmas) != calibration["sigmas"]["midgame"] + calibration["sigmas"]["exact"]:
+        raise ValueError("rules.json does not exactly match the model")
+    lookup = {(r[2], r[1]): r for r in actual if not r[0]}
+    errors = []
+    position_count = 0
+    with positions.open() as f:
+        rows = csv.DictReader((line for line in f if not line.startswith("#")), delimiter="\t")
+        for row in rows:
+            empties = int(row["empties"])
+            values = [int(v) for v in row["values"].split(",")]
+            if 64 - (int(row["player"], 16) | int(row["opponent"], 16)).bit_count() != empties:
+                raise ValueError("position empties mismatch")
+            position_count += 1
+            for depth in range(4, len(values)):
+                _, _, _, shallow, slope, intercept, deviation = lookup[(empties, depth)]
+                if deviation > 0:
+                    errors.append(abs(values[depth] - slope * values[shallow] - intercept) / deviation)
+    errors.sort()
+    if len(errors) < 100:
+        raise ValueError("too few calibration pairs")
+    anchors = {}
+    for p, sigma in zip((68, 77, 85, 95, 98, 99), sigmas[:6]):
+        measured = quantile(errors, p / 100)
+        if not math.isclose(measured, sigma, rel_tol=1e-12, abs_tol=1e-12):
+            raise ValueError(f"original {p}% multiple does not reproduce from positions.tsv")
+        anchors[str(p)] = {"model": sigma, "recomputed": measured}
+    return {"sigmas": {str(p): quantile(errors, p / 100) for p in probabilities},
+            "positions": position_count, "midgame_pairs": len(errors), "anchors": anchors,
+            "sources": {name: {"path": str(path.resolve()), "sha256": digest(path)}
+                        for name, path in [("model", model), ("rules", rules_path), ("positions", positions)]}}
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--model", type=Path, required=True)
+    parser.add_argument("--rules", type=Path, required=True)
+    parser.add_argument("--positions", type=Path, required=True)
+    parser.add_argument("--probabilities", default="77,81,85,89,92,95")
+    parser.add_argument("--out", type=Path, required=True)
+    args = parser.parse_args()
+    probabilities = [int(s) for s in args.probabilities.split(",")]
+    if not probabilities or any(not 1 <= p <= 99 for p in probabilities):
+        parser.error("probabilities must be between 1 and 99")
+    result = generate(args.model, args.rules, args.positions, probabilities)
+    args.out.parent.mkdir(parents=True, exist_ok=True)
+    args.out.write_text(json.dumps(result, indent=2) + "\n")
+    print(json.dumps({k: result[k] for k in ("sigmas", "positions", "midgame_pairs")}, indent=2))
