+#[cfg(test)]
+mod tests {
+    use super::*;
+    use deft_reversi_engine::{PatternModel, legacy_main_rules};
+
+    #[test]
+    fn custom_midgame_calibration_restores_the_original_endgame_settings() {
+        let rules = legacy_main_rules();
+        let model = Model::from_pattern(PatternModel::zero())
+            .with_calibration(rules.clone(), ProbCutSigmas::NORMAL)
+            .unwrap();
+        let mut engine = Engine::new(model, EngineOptions::default().tt_mib(1)).unwrap();
+        let mut original = Vec::new();
+        engine.write_analysis_settings(&mut original).unwrap();
+        let custom = MidgameCalibration {
+            rules,
+            original: ProbCutSigmas::NORMAL,
+            sigma: 1.7,
+            stage: Selectivity::Percent85 as usize,
+        };
+        custom.apply(&mut engine).unwrap();
+        let mut changed = Vec::new();
+        engine.write_analysis_settings(&mut changed).unwrap();
+        assert_ne!(changed, original);
+        let mut expected_sigmas = ProbCutSigmas::NORMAL;
+        expected_sigmas.midgame[Selectivity::Percent85 as usize] = 1.7;
+        let expected_model = Model::from_pattern(PatternModel::zero())
+            .with_calibration(legacy_main_rules(), expected_sigmas)
+            .unwrap();
+        let expected_engine =
+            Engine::new(expected_model, EngineOptions::default().tt_mib(1)).unwrap();
+        let mut expected = Vec::new();
+        expected_engine
+            .write_analysis_settings(&mut expected)
+            .unwrap();
+        assert_eq!(changed, expected);
+        custom.restore(&mut engine).unwrap();
+        let mut restored = Vec::new();
+        engine.write_analysis_settings(&mut restored).unwrap();
+        assert_eq!(restored, original);
+        custom.apply(&mut engine).unwrap();
+        let mut next_game = Vec::new();
+        engine.write_analysis_settings(&mut next_game).unwrap();
+        assert_eq!(next_game, changed);
+    }
+}
