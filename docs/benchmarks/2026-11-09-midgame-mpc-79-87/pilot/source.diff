+/// Timed searches complete each depth from one; otherwise retain the
+/// reference solver's two-ply steps and target parity.
+fn iterative_depths(target: u8, timed: bool) -> Vec<u8> {
     if target <= 1 {
         return vec![target];
     }
+    if timed {
+        return (1..=target).collect();
+    }
     let start = (6 - (target & 1)).min(target - 2);
