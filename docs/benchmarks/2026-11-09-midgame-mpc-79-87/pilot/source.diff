+impl MidgameCalibration {
+    fn apply(&self, engine: &mut Engine) -> Result<(), EngineError> {
+        let mut sigmas = self.original;
+        // Preserve every endgame multiple and all other midgame stages.
+        sigmas.midgame[self.stage] = self.sigma;
+        engine.set_probcut_calibration(self.rules.clone(), sigmas)
+    }
