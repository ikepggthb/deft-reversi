diff --git a/deft-reversi-engine/src/parallel.rs b/deft-reversi-engine/src/parallel.rs
index af1d395..197ae8e 100644
--- a/deft-reversi-engine/src/parallel.rs
+++ b/deft-reversi-engine/src/parallel.rs
@@ -13,6 +13,9 @@ pub(crate) enum Dispatch {
     Worker,
 }
 pub(crate) type Job = Box<dyn FnOnce() + Send + 'static>;
+pub static DIAG_JOIN_TIMEOUTS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_JOIN_WAITS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static DIAG_DRAIN_TIMEOUTS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
 /// Keeps a value on cache lines of its own (two lines, for the adjacent-line
 /// prefetcher), so that writes to it do not evict data other threads read
 /// on every node, and `Arc` reference counts stay off its line.
@@ -196,10 +199,14 @@ impl Helper {
             }
             state.waiting = true;
             self.available.store(true, Ordering::Release);
-            let (mut state, _) = self
+            DIAG_JOIN_WAITS.fetch_add(1, Ordering::Relaxed);
+            let (mut state, timeout) = self
                 .ready
                 .wait_timeout(state, Duration::from_millis(5))
                 .unwrap_or_else(|p| p.into_inner());
+            if timeout.timed_out() {
+                DIAG_JOIN_TIMEOUTS.fetch_add(1, Ordering::Relaxed);
+            }
             state.waiting = false;
             self.available.store(false, Ordering::Release);
         }
