+/// How long an idle thread polls for work before it blocks. Blocking and
+/// waking moves threads between cores, away from their cached data.
+const SPIN: Duration = Duration::from_micros(50);
+/// Polls `ready` without blocking until it holds or `SPIN` has passed.
+fn spin_until(ready: impl Fn() -> bool) -> bool {
+    let start = Instant::now();
+    loop {
+        for _ in 0..32 {
+            if ready() {
+                return true;
+            }
+            std::hint::spin_loop();
+        }
+        if start.elapsed() >= SPIN {
+            return ready();
+        }
+    }
+}
