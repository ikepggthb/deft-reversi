+impl Runtime {
+    /// Joins the open split point with the most depth left (one below
+    /// `within`, if given), counted as one of its helper jobs.
+    fn claim_open(&self, within: Option<&Arc<Helper>>) -> Option<Arc<Split>> {
+        let open = parallel::lock(&self.open_splits);
+        let point = open
+            .iter()
+            .filter(|point| {
+                point.open.load(Ordering::Acquire)
+                    && within
+                        .is_none_or(|helper| point.ancestors.iter().any(|a| Arc::ptr_eq(a, helper)))
+            })
+            .min_by_key(|point| point.depth)?
+            .clone();
+        // Counted under the lock: a point leaves the list before its master
+        // joins, so the master waits for this job too.
+        point.active.fetch_add(1, Ordering::AcqRel);
+        self.pending.fetch_add(1, Ordering::AcqRel);
+        Some(point)
+    }
+}
+/// A job that searches remaining moves of `point`, whose `active` and the
+/// runtime's `pending` already count it. A thread outside any join then
+/// keeps taking open split points before it goes idle.
+fn helper_job(runtime: Arc<Runtime>, point: Arc<Split>) -> parallel::Job {
+    Box::new(move || {
+        let mut point = point;
+        loop {
+            help(&runtime, &point);
+            if JOINS.get() != 0 || !PULL_WORKERS {
+                break;
+            }
+            let Some(next) = runtime.claim_open(None) else {
+                break;
+            };
+            point = next;
+        }
+    })
+}
+fn help(runtime: &Arc<Runtime>, point: &Arc<Split>) {
+    let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+        let mut context =
+            Context::new(runtime.clone(), point.ancestors.clone(), point.cuts.clone());
+        context.end_cache = EndgameCache::take_thread(runtime.cache_epoch);
+        context.stats.helper_jobs += 1;
+        context.split_loop(point);
+        std::mem::take(&mut context.end_cache).put_thread(runtime.cache_epoch);
+    }));
+    if result.is_err() {
+        runtime.control.reason.store(4, Ordering::Release);
+    }
+    point.active.fetch_sub(1, Ordering::AcqRel);
+    point.helper.wake();
+    runtime.finish_pending();
+}
