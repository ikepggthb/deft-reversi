+    fn shared_endgame_score(
+        &mut self,
+        board: Board,
+        alpha: i32,
+        beta: i32,
+        known_moves: Option<u64>,
+    ) -> Result<i32, ()> {
+        let empties = board.empty_count();
+        let quality = self.end_quality(empties);
+        let mut best_move = 64;
+        if let Some(entry) = self.runtime.table.get(board) {
+            // Any entry's move is a usable ordering hint; bounds need the same
+            // exact depth and selectivity.
+            best_move = entry.best;
+            if entry.exact_mode && entry.depth == empties && entry.quality == quality {
+                self.stats.tt_hits += 1;
+                if i32::from(entry.lower) >= beta {
+                    self.stats.tt_cuts += 1;
+                    return Ok(i32::from(entry.lower));
+                }
+                if i32::from(entry.upper) <= alpha {
+                    self.stats.tt_cuts += 1;
+                    return Ok(i32::from(entry.upper));
+                }
+            }
+        }
+        let score = self.ordered_endgame(board, alpha, beta, known_moves, &mut best_move)?;
+        let (lower, upper) = if score >= beta {
+            (score as i8, 64)
+        } else {
+            (-64, score as i8)
+        };
+        self.runtime.table.store(
+            board,
+            crate::transposition::Entry {
+                lower,
+                upper,
+                depth: empties,
+                quality,
+                best: best_move,
+                second: 64,
+                generation: self.runtime.generation,
+                exact_mode: true,
+            },
+        );
+        Ok(score)
+    }
