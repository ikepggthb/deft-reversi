+#[test]
+fn timed_searches_complete_every_depth_and_preserve_selectivity() {
+    let mut engine = engine(1);
+    for (target, timed, expected) in [
+        (5, true, vec![1, 2, 3, 4, 5]),
+        (6, true, vec![1, 2, 3, 4, 5, 6]),
+        (5, false, vec![3, 5]),
+        (6, false, vec![4, 6]),
+    ] {
+        engine.clear_tt().unwrap();
+        let mut request = depth(target).selectivity(Selectivity::Percent85);
+        if timed {
+            request = request.time_limit(Duration::from_secs(60));
+        }
+        let mut depths = Vec::new();
+        let result = engine
+            .search_with(Board::new(), &request, |progress| {
+                let ResultKind::Depth { depth, selectivity } = progress.kind else {
+                    panic!("expected midgame iteration");
+                };
+                assert_eq!(selectivity, Selectivity::Percent85);
+                depths.push(depth);
+            })
+            .unwrap();
+        assert_eq!(result.stop_reason, StopReason::Completed);
+        assert_eq!(depths, expected);
+    }
+}
+
+#[test]
