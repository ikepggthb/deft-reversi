diff --git a/tools/bench/mpc_match.py b/tools/bench/mpc_match.py
new file mode 100644
--- /dev/null
+++ b/tools/bench/mpc_match.py
@@ -0,0 +1,208 @@
+#!/usr/bin/env python3
+"""Fixed-time midgame MPC self-play, sequential on one CPU.
+
+python3 tools/bench/mpc_match.py --out OUT --openings 4 --budgets 25,100
+Candidates play a baseline with colours swapped on identical XOT openings.
+Only roots above --endgame-empties use the candidate selectivity. Endgame
+requests, their time cap, and the TT reset at the boundary are shared.
+"""
+import argparse
+import csv
+import hashlib
+import json
+import os
+import random
+import statistics
+import subprocess
+import time
+from pathlib import Path
+
+from common import POSITIONS, REPO, paths
+from match import Gtp, play_game, xot
+
+
+def sha256(path):
+    with open(path, "rb") as f:
+        return hashlib.file_digest(f, "sha256").hexdigest()
+
+
+def percentile(values, fraction):
+    values = sorted(values)
+    return values[round((len(values) - 1) * fraction)] if values else None
+
+
+def validate_moves(rows, percent, budget, endgame_empties, endgame_ms):
+    if not rows:
+        raise RuntimeError("missing move telemetry")
+    end_rows = []
+    for row in rows:
+        end = row["empties"] <= endgame_empties
+        if row["phase"] != ("endgame" if end else "midgame"):
+            raise RuntimeError("incorrect phase boundary")
+        if row["budget_ms"] != (endgame_ms if end else budget):
+            raise RuntimeError("incorrect move budget")
+        if row["stop"] == "WorkerFailed" or not row["iterations"]:
+            raise RuntimeError("worker failure or no completed iteration")
+        if not end:
+            if row["reset_tt"] or row["endgame"] or any(
+                p["endgame"] or p["percent"] != percent for p in row["iterations"]
+            ):
+                raise RuntimeError("midgame settings changed during search")
+        else:
+            end_rows.append(row)
+    if end_rows and [r["reset_tt"] for r in end_rows] != [True] + [False] * (len(end_rows) - 1):
+        raise RuntimeError("endgame TT reset must happen exactly once per engine/game")
+
+
+def telemetry_summary(rows):
+    mid = [r for r in rows if r["phase"] == "midgame"]
+    end = [r for r in rows if r["phase"] == "endgame"]
+    last_has_searches = 0
+    for r in mid:
+        it = r["iterations"]
+        last_has_searches += it[-1]["searches"] > (it[-2]["searches"] if len(it) > 1 else 0)
+    return {
+        "mid_moves": len(mid),
+        "mean_depth": statistics.mean(r["depth"] for r in mid) if mid else None,
+        "mid_search_ms_median": percentile([r["search_ms"] for r in mid], .5),
+        "mid_search_ms_p95": percentile([r["search_ms"] for r in mid], .95),
+        "mid_search_ms_max": max((r["search_ms"] for r in mid), default=None),
+        "mid_wall_ms_p95": percentile([r["wall_ms"] for r in mid], .95),
+        "mid_wall_ms_max": max((r["wall_ms"] for r in mid), default=None),
+        "last_iteration_mpc_moves": last_has_searches,
+        "mid_cuts": sum(r["cuts"] for r in mid),
+        "mid_verification_searches": sum(r["searches"] for r in mid),
+        "mean_last_done_ms": statistics.mean(r["iterations"][-1]["elapsed_ms"] for r in mid) if mid else None,
+        "end_moves": len(end),
+        "end_solved": sum(r["solved"] for r in end),
+        "end_search_ms_p95": percentile([r["search_ms"] for r in end], .95),
+        "end_wall_ms_max": max((r["wall_ms"] for r in end), default=None),
+    }
+
+
+def summarize(out, games):
+    groups = {}
+    for game in games:
+        key = (int(game["budget_ms"]), int(game["candidate"]))
+        groups.setdefault(key, []).append(game)
+    report = []
+    for (budget, candidate), group in sorted(groups.items()):
+        diffs = [int(g["diff"]) for g in group]
+        telemetry = {"candidate": [], "baseline": []}
+        pairs = {}
+        for g in group:
+            pairs.setdefault(g["opening"], []).append((int(g["diff"]) > 0) + .5 * (int(g["diff"]) == 0))
+            for side in telemetry:
+                log = out / "logs" / f'{g["id"]}-{side}.jsonl'
+                telemetry[side].extend(json.loads(line) for line in log.read_text().splitlines())
+        if any(len(pair) != 2 for pair in pairs.values()):
+            raise RuntimeError("incomplete colour pair")
+        pair_scores = [statistics.mean(pair) for pair in pairs.values()]
+        rng = random.Random(1)
+        boot = [statistics.mean(rng.choices(pair_scores, k=len(pair_scores))) for _ in range(2000)]
+        report.append({
+            "budget_ms": budget, "candidate": candidate, "games": len(group),
+            "wins": sum(d > 0 for d in diffs), "draws": sum(d == 0 for d in diffs),
+            "losses": sum(d < 0 for d in diffs), "score": statistics.mean(pair_scores),
+            "paired_bootstrap_95": [percentile(boot, .025), percentile(boot, .975)],
+            "mean_diff": statistics.mean(diffs),
+            "mean_game_seconds": statistics.mean(float(g["wall_seconds"]) for g in group),
+            **{side + "_stats": telemetry_summary(rows) for side, rows in telemetry.items()},
+        })
+    (out / "summary.json").write_text(json.dumps(report, indent=2) + "\n")
+    for r in report:
+        print(f'{r["budget_ms"]}ms p{r["candidate"]}: {r["wins"]}/{r["draws"]}/{r["losses"]}'
+              f' score={r["score"]:.1%} depth={r["candidate_stats"]["mean_depth"]:.2f}'
+              f' vs {r["baseline_stats"]["mean_depth"]:.2f}')
+    return report
+
+
+def main():
+    tools = paths()
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--out", type=Path, required=True)
+    parser.add_argument("--gtp", type=Path, default=tools["gtp"])
+    parser.add_argument("--model", type=Path, default=tools["model"])
+    parser.add_argument("--xot", type=Path, default=POSITIONS / "xot-openingslarge.txt")
+    parser.add_argument("--openings", type=int, default=4)
+    parser.add_argument("--seed", type=int, default=1)
+    parser.add_argument("--budgets", default="25,100")
+    parser.add_argument("--candidates", default="68,95,99,100")
+    parser.add_argument("--baseline", type=int, default=85)
+    parser.add_argument("--endgame-empties", type=int, default=18)
+    parser.add_argument("--endgame-ms", type=int, default=25)
+    parser.add_argument("--cpu", type=int, default=0)
+    args = parser.parse_args()
+    budgets = [int(s) for s in args.budgets.split(",")]
+    candidates = [int(s) for s in args.candidates.split(",")]
+    allowed = {68, 77, 85, 95, 98, 99, 100}
+    if (not candidates or len(set(candidates)) != len(candidates) or not set(candidates) <= allowed
+            or args.baseline not in allowed or args.baseline in candidates
+            or not budgets or min(budgets) <= 0 or len(set(budgets)) != len(budgets)
+            or args.openings <= 0 or not 0 <= args.endgame_empties <= 52 or args.endgame_ms <= 0):
+        parser.error("invalid probabilities, budgets, opening count or boundary")
+    if args.cpu not in os.sched_getaffinity(0):
+        parser.error("CPU is outside the process affinity")
+    openings = xot(args.openings, args.xot, args.seed)
+    settings = {k: str(v.resolve()) if isinstance(v, Path) else v for k, v in vars(args).items() if k != "out"}
+    settings.update({"gtp_sha256": sha256(args.gtp), "model_sha256": sha256(args.model),
+                     "xot_sha256": sha256(args.xot), "runner_sha256": sha256(__file__), "openings_moves": openings})
+    args.out.mkdir(parents=True, exist_ok=True)
+    manifest = args.out / "manifest.json"
+    if manifest.exists():
+        if json.loads(manifest.read_text())["settings"] != settings:
+            raise SystemExit("output settings differ; use a fresh output directory")
+    else:
+        manifest.write_text(json.dumps({"settings": settings,
+            "commit": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=REPO, text=True).strip(),
+            "cpu": subprocess.check_output(["lscpu"], text=True),
+        }, indent=2) + "\n")
+        (args.out / "source.diff").write_bytes(subprocess.check_output(["git", "diff"], cwd=REPO))
+        (args.out / "runner.py").write_bytes(Path(__file__).read_bytes())
+    (args.out / "logs").mkdir(exist_ok=True)
+    result_path = args.out / "games.tsv"
+    games = list(csv.DictReader(result_path.open(), delimiter="\t")) if result_path.exists() else []
+    done = {g["id"] for g in games}
+    os.environ["DEFT_GTP_JSON"] = "1"
+    fields = ["id", "opening", "budget_ms", "candidate", "candidate_color", "diff", "candidate_seconds", "baseline_seconds", "wall_seconds", "moves"]
+    with result_path.open("a") as f:
+        writer = csv.DictWriter(f, fields, delimiter="\t")
+        if not games:
+            writer.writeheader()
+        for opening_id, opening in enumerate(openings):
+            for budget in budgets:
+                # Rotate both candidate order and which colour plays first.
+                order = candidates[opening_id % len(candidates):] + candidates[:opening_id % len(candidates)]
+                for candidate in order:
+                    for black in ([True, False] if opening_id % 2 == 0 else [False, True]):
+                        game_id = f"o{opening_id}-t{budget}-p{candidate}-{'b' if black else 'w'}"
+                        if game_id in done:
+                            continue
+                        engines = {}
+                        started = time.monotonic()
+                        try:
+                            for side, percent in [("candidate", candidate), ("baseline", args.baseline)]:
+                                log = args.out / "logs" / f"{game_id}-{side}.jsonl"
+                                log.write_text("")
+                                engines[side] = Gtp([str(args.gtp), str(args.model), "--move-ms", str(budget),
+                                    "--mid-selectivity", str(percent), "--endgame-empties", str(args.endgame_empties),
+                                    "--endgame-ms", str(args.endgame_ms), "--tt", "64"], args.cpu, log=log)
+                            diff, cs, bs, record = play_game({"deft": engines["candidate"], "opp": engines["baseline"]}, black, opening, "fixed")
+                        finally:
+                            for engine in engines.values():
+                                engine.close()
+                                engine.proc.wait(timeout=5)
+                        for side, percent in [("candidate", candidate), ("baseline", args.baseline)]:
+                            rows = [json.loads(line) for line in (args.out / "logs" / f"{game_id}-{side}.jsonl").read_text().splitlines()]
+                            validate_moves(rows, percent, budget, args.endgame_empties, args.endgame_ms)
+                        game = dict(zip(fields, [game_id, opening_id, budget, candidate, "black" if black else "white",
+                            diff, cs, bs, time.monotonic() - started, record]))
+                        writer.writerow(game)
+                        f.flush()
+                        games.append({k: str(v) for k, v in game.items()})
+                        print(f"{game_id}: {diff:+d} ({game['wall_seconds']:.2f}s)", flush=True)
+    summarize(args.out, games)
+
+
+if __name__ == "__main__":
+    main()
