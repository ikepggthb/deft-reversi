     }
     ids
 };
+
+/// Reference presorted square order (corners first, X-squares and the centre
+/// last): `RANK[square]` is the square's position in that order.
+#[rustfmt::skip]
+const RANK: [u8; 64] = [
+     0, 50, 18, 26, 28, 20, 52,  2,
+    48, 56, 42, 34, 36, 44, 58, 54,
+    16, 40, 12,  6,  8, 14, 46, 22,
+    24, 32,  4, 60, 61, 10, 38, 30,
+    25, 33,  5, 62, 63, 11, 39, 31,
+    17, 41, 13,  7,  9, 15, 47, 23,
+    49, 57, 43, 35, 37, 45, 59, 55,
+     1, 51, 19, 27, 29, 21, 53,  3,
+];
+#[rustfmt::skip]
+pub(super) const UNRANK: [u8; 64] = [
+     0, 56,  7, 63, 26, 34, 19, 43,
+    20, 44, 29, 37, 18, 42, 21, 45,
+    16, 40,  2, 58,  5, 61, 23, 47,
+    24, 32,  3, 59,  4, 60, 31, 39,
+    25, 33, 11, 51, 12, 52, 30, 38,
+    17, 41, 10, 50, 13, 53, 22, 46,
+     8, 48,  1, 57,  6, 62, 15, 55,
+     9, 49, 14, 54, 27, 28, 35, 36,
+];
+
+/// `squares` mapped to rank space; iterating its bits from the lowest visits
+/// the squares in the presorted order without sorting.
+#[inline(always)]
+pub(super) fn ranked(mut squares: u64) -> u64 {
+    let mut ranks = 0;
+    while squares != 0 {
+        ranks |= 1u64 << RANK[squares.trailing_zeros() as usize];
+        squares &= squares - 1;
+    }
+    ranks
+}
