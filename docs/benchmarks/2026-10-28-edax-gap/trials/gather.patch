+/// Feature lanes rounded up so differential updates are whole vector adds.
+const LANES: usize = 48;
+
+/// `SQUARE_DELTA[sq][f]` is the base-3 weight of `sq` in feature `f`, or 0.
+static SQUARE_DELTA: [[u16; LANES]; 64] = {
+    let mut table = [[0u16; LANES]; 64];
+    let mut sq = 0;
+    while sq < 64 {
+        let features = &SQUARE_TO_FEATURES[sq];
+        let mut i = 0;
+        while i < features.len as usize {
+            let feature = features.features[i];
+            table[sq][feature.feature_idx as usize] = feature.base3_weight;
+            i += 1;
+        }
+        sq += 1;
+    }
+    table
+};
+
+/// First weight of each lane's table; padding lanes read entry 0.
+const LANE_OFFSET: [u32; LANES] = {
+    let mut out = [0u32; LANES];
+    let mut offset = 0;
+    let mut p = 0;
+    while p < PATTERN_COUNT {
+        let mut r = 0;
+        while r < 4 {
+            out[p * 4 + r] = offset as u32;
+            r += 1;
+        }
+        offset += PATTERN_TABLE_SIZES[p];
+        p += 1;
+    }
+    out
+};
+/// Largest valid index of each lane's table (0 for padding lanes).
+const LANE_LIMIT: [u32; LANES] = {
+    let mut out = [0u32; LANES];
+    let mut i = 0;
+    while i < PATTERN_COUNT * 4 {
+        out[i] = PATTERN_TABLE_SIZES[i / 4] as u32 - 1;
+        i += 1;
+    }
+    out
+};
+
+/// Sum of the 44 pattern weights selected by `indices`.
+#[cfg(all(target_arch = "x86_64", target_feature = "avx2"))]
+#[inline]
+fn pattern_sum(weights: &[i16], indices: &[u16; LANES]) -> i32 {
+    use std::arch::x86_64::*;
+    assert!(weights.len() > TOTAL_PATTERN_WEIGHTS);
+    // SAFETY: AVX2 is enabled. Each lane index is clamped to its table, so the
+    // 32-bit read at an i16 offset ends at most at the padding element.
+    unsafe {
+        let mut sum = _mm256_setzero_si256();
+        for chunk in 0..LANES / 8 {
+            let index =
+                _mm256_cvtepu16_epi32(_mm_loadu_si128(indices.as_ptr().add(chunk * 8).cast()));
+            let index = _mm256_min_epu32(
+                index,
+                _mm256_loadu_si256(LANE_LIMIT.as_ptr().add(chunk * 8).cast()),
+            );
+            let index = _mm256_add_epi32(
+                index,
+                _mm256_loadu_si256(LANE_OFFSET.as_ptr().add(chunk * 8).cast()),
+            );
+            let raw = _mm256_i32gather_epi32::<2>(weights.as_ptr().cast(), index);
+            let mut value = _mm256_srai_epi32::<16>(_mm256_slli_epi32::<16>(raw));
+            if chunk == LANES / 8 - 1 {
+                // Lanes 44..48 are padding.
+                value = _mm256_blend_epi32::<0b1111_0000>(value, _mm256_setzero_si256());
+            }
+            sum = _mm256_add_epi32(sum, value);
+        }
+        let half = _mm_add_epi32(
+            _mm256_castsi256_si128(sum),
+            _mm256_extracti128_si256::<1>(sum),
+        );
+        let half = _mm_add_epi32(half, _mm_unpackhi_epi64(half, half));
+        _mm_cvtsi128_si32(_mm_add_epi32(half, _mm_shuffle_epi32::<1>(half)))
+    }
+}
