+            map[END_PATTERNS[group] * 4 + r] = (group * 4 + r) as u8;
+            r += 1;
+        }
+        group += 1;
+    }
+    map
+};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct EndOrderingState {
