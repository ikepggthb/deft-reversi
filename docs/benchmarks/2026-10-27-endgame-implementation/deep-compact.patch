+impl EndOrderingState {
+    pub(crate) fn from_state(state: &EvalState) -> Self {
+        let mut out = Self {
+            current: [0; 16],
+            swapped: [0; 16],
+        };
+        for (group, &pattern) in END_PATTERNS.iter().enumerate() {
+            for r in 0..4 {
