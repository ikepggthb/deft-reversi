+// corner 3x3 and corner triangle. These are not separately trained weights.
+const END_PATTERNS: [usize; 4] = [0, 1, 5, 6];
+const END_OFFSETS: [usize; 4] = {
+    let mut out = [0; 4];
+    let mut i = 0;
+    while i < 4 {
+        let mut p = 0;
+        while p < END_PATTERNS[i] {
