+// Diagnostic reconstruction of the previous whole-root Context::node driver.
+pub(super) fn legacy_iteration(context: &mut Context,position: Position,spec: SearchSpec,prediction:i32,target:u8) -> Result<Line,()> {
+    let radius = if spec.exact { (10-i32::from(target)).max(2+prediction.rem_euclid(2)) }
+        else if spec.depth>16 {2} else {6};
+    let full_window = !spec.exact && spec.depth<=10;
+    let mut pivot=prediction;
+    let (mut left,mut right)=(radius,radius);
+    let (mut alpha,mut beta)=if full_window {(-65,65)} else {aspiration_window(pivot,left,right,spec.exact)};
+    loop {
+        let start=Instant::now();let nodes=context.stats.nodes;
+        let line=context.node(position,alpha,beta,spec)?;
+        if context.runtime.trace {eprintln!("INV_LEGACY_WINDOW {}",serde_json::json!({"alpha":alpha,"beta":beta,"depth":spec.depth,"sigma":context.runtime.sigma(),"score":line.score,"nodes":context.stats.nodes-nodes,"seconds":start.elapsed().as_secs_f64()}));}
+        if line.score>alpha && line.score<beta {return Ok(line);}
+        if line.score<=alpha && left!=0 {left=(left*2).min(128);right=0;}
+        else if line.score>=beta && right!=0 {right=(right*2).min(128);left=0;}
+        else {left=128;right=128;}
+        pivot=line.score;
+        (alpha,beta)=aspiration_window(pivot,left,right,spec.exact);
+    }
+}
