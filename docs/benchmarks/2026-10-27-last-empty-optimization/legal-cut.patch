+    // With one empty square, a ray can flip iff it has a closing player disc
+    // and its immediate neighbour is an opponent disc. No flip count is needed.
+    #[inline(always)]
+    pub fn last_move_is_legal(pos: usize, player: u64, neighbours: u64) -> bool {
+        // SAFETY: the module is compiled with AVX2; both mask loads fit V8DI.
+        unsafe {
+            let pp = _mm256_set1_epi64x(player as i64);
+            let [left, right] = load_256(&LR_MASK[pos]);
+            let left_opponent = _mm256_andnot_si256(pp, left);
+            let right_opponent = _mm256_andnot_si256(pp, right);
+            let left_valid =
+                _mm256_andnot_si256(_mm256_cmpeq_epi64(left_opponent, left), left_opponent);
+            let right_valid =
+                _mm256_andnot_si256(_mm256_cmpeq_epi64(right_opponent, right), right_opponent);
+            let candidates = _mm256_or_si256(left_valid, right_valid);
+            _mm256_testz_si256(candidates, _mm256_set1_epi64x(neighbours as i64)) == 0
         }
     }
 
