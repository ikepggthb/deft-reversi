@@ -58,3 +58,46 @@ pub(super) const QUADRANT_ID: [i32; 64] = {
     }
     ids
 };
+
+/// Reference presorted empty-square order: corners first, X-squares and the
+/// centre last. Shallow kernels search odd quadrants first in this order.
+#[rustfmt::skip]
+const SQUARE_RANK: [u8; 64] = [
+     0, 50, 18, 26, 28, 20, 52,  2,
+    48, 56, 42, 34, 36, 44, 58, 54,
+    16, 40, 12,  6,  8, 14, 46, 22,
+    24, 32,  4, 60, 61, 10, 38, 30,
+    25, 33,  5, 62, 63, 11, 39, 31,
+    17, 41, 13,  7,  9, 15, 47, 23,
+    49, 57, 43, 35, 37, 45, 59, 55,
+     1, 51, 19, 27, 29, 21, 53,  3,
+];
+
+/// Empty squares sorted by `SQUARE_RANK`; `N` must equal the empty count.
+#[inline(always)]
+pub(super) fn sorted_empties<const N: usize>(mut empty: u64) -> [u8; N] {
+    debug_assert_eq!(empty.count_ones() as usize, N);
+    let mut squares = [0u8; N];
+    for filled in 0..N {
+        let square = empty.trailing_zeros() as u8;
+        empty &= empty - 1;
+        let mut i = filled;
+        while i > 0 && SQUARE_RANK[usize::from(squares[i - 1])] > SQUARE_RANK[usize::from(square)] {
+            squares[i] = squares[i - 1];
+            i -= 1;
+        }
+        squares[i] = square;
+    }
+    squares
+}
+
+/// The ordered list without its `index`-th square.
+#[inline(always)]
+pub(super) fn without<const N: usize, const M: usize>(squares: [u8; N], index: usize) -> [u8; M] {
+    debug_assert_eq!(N, M + 1);
+    let mut rest = [0u8; M];
+    for i in 0..M {
+        rest[i] = squares[i + usize::from(i >= index)];
+    }
+    rest
+}
