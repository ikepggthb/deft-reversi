+
+pub static HIST: [std::sync::atomic::AtomicU64; 65] =
+    [const { std::sync::atomic::AtomicU64::new(0) }; 65];
+#[inline(always)]
+pub(crate) fn hist(empties: u8) {
+    HIST[usize::from(empties)].fetch_add(1, std::sync::atomic::Ordering::Relaxed);
+}
+pub fn hist_take() -> Vec<u64> {
+    HIST.iter().map(|h| h.swap(0, std::sync::atomic::Ordering::Relaxed)).collect()
+}
